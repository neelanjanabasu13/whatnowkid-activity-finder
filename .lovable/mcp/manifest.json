{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "whatnow-kid-mcp",
      "version": "0.1.0",
      "title": "WhatNow Kid"
    },
    "tools": [
      {
        "name": "find_activities",
        "title": "Find kids activities",
        "description": "Search the WhatNow Kid activity bank for age-appropriate, mood-matched ideas. Filter by age range, goal, environment, cost, and parenting style. Returns up to `limit` matching activities.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "ages": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "0-1",
                  "1-3",
                  "3-6",
                  "6-10",
                  "10+"
                ]
              },
              "description": "One or more child age ranges to match. Omit for any age."
            },
            "goals": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Calm Down",
                  "Burn Energy",
                  "Beat Boredom",
                  "Connect",
                  "Quiet Time"
                ]
              },
              "description": "One or more parenting goals to match. Omit for any goal."
            },
            "environment": {
              "type": "string",
              "enum": [
                "Any",
                "Indoor",
                "Outdoor"
              ],
              "default": "Any",
              "description": "Where the activity takes place."
            },
            "cost": {
              "type": "string",
              "enum": [
                "Any",
                "Free",
                "Paid"
              ],
              "default": "Any",
              "description": "Whether the activity requires paid materials."
            },
            "parenting": {
              "type": "string",
              "enum": [
                "Hands On",
                "Hands Off"
              ],
              "description": "Parenting involvement level. Omit for either."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Max activities to return (1-50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "random_activity",
        "title": "Pick a random kids activity",
        "description": "Return one random WhatNow Kid activity idea, optionally narrowed by age, goal, environment, cost, or parenting style. Great for 'I'm feeling lucky' style prompts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "ages": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "0-1",
                  "1-3",
                  "3-6",
                  "6-10",
                  "10+"
                ]
              }
            },
            "goals": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Calm Down",
                  "Burn Energy",
                  "Beat Boredom",
                  "Connect",
                  "Quiet Time"
                ]
              }
            },
            "environment": {
              "type": "string",
              "enum": [
                "Any",
                "Indoor",
                "Outdoor"
              ],
              "default": "Any"
            },
            "cost": {
              "type": "string",
              "enum": [
                "Any",
                "Free",
                "Paid"
              ],
              "default": "Any"
            },
            "parenting": {
              "type": "string",
              "enum": [
                "Hands On",
                "Hands Off"
              ]
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_filters",
        "title": "List available filters",
        "description": "Return the full set of filter values supported by the WhatNow Kid activity bank (age ranges, goals, environments, costs, parenting styles) plus the total activity count. Call this first if you're unsure what to pass to find_activities.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
